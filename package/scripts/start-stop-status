#!/bin/sh
# DSM calls this script with start / stop / status as the first argument.

DAEMON=/var/packages/cardimportd/target/cardimportd
CONFIG=/var/packages/cardimportd/etc/config.yaml
PIDFILE=/var/packages/cardimportd/var/cardimportd.pid
LOG=/var/packages/cardimportd/var/cardimportd.log
STOPPING_FILE=/var/packages/cardimportd/var/.stopping

start_daemon() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
        echo "cardimportd is already running"
        exit 0
    fi
    rm -f "$STOPPING_FILE"
    (
        while [ ! -f "$STOPPING_FILE" ]; do
            "$DAEMON" --config "$CONFIG" >> "$LOG" 2>&1
            code=$?
            [ -f "$STOPPING_FILE" ] && break
            printf '{"time":"%s","level":"WARN","msg":"cardimportd exited, restarting in 5s","code":%s}\n' "$(date -Iseconds)" "$code" >> "$LOG"
            sleep 5
        done
    ) &
    LOOP_PID=$!
    # Give the daemon a moment to start, then record its PID
    sleep 1
    DAEMON_PID=$(pgrep -P $LOOP_PID cardimportd 2>/dev/null || echo $LOOP_PID)
    echo "$LOOP_PID" > "$PIDFILE"
    echo "cardimportd started (watchdog PID $LOOP_PID)"
}

stop_daemon() {
    if [ ! -f "$PIDFILE" ]; then
        echo "cardimportd is not running"
        exit 0
    fi
    touch "$STOPPING_FILE"
    PID=$(cat "$PIDFILE")
    # Kill the entire process group
    pkill -P "$PID" 2>/dev/null
    kill "$PID" 2>/dev/null
    rm -f "$PIDFILE"
    echo "cardimportd stopped"
}

status_daemon() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
        echo "cardimportd is running (PID $(cat $PIDFILE))"
        exit 0
    fi
    echo "cardimportd is not running"
    exit 3
}

case "$1" in
    start)   start_daemon ;;
    stop)    stop_daemon ;;
    status)  status_daemon ;;
    restart) stop_daemon; sleep 1; start_daemon ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
